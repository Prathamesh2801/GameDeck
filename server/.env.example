# Copy to .env (never commit .env). On cPanel set these in the Node.js app's
# environment variables instead.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gamedeck

# Dashboard login password.
ADMIN_PASSWORD=
# Long random string used to sign admin login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN_SECRET=

# PORT=4000   # local only; cPanel provides PORT itself
